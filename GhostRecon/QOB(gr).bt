//------------------------------------------------
//--- 010 Editor v7.0 Binary Template
//
//      File: QOB.bt
//   Authors: Alexander Evdokimov
//   Version: 1.3
//   Purpose: Ghost Recon QOB file (one geometry: weapons, props, ground cover; metres, Z up)
//
//   History:
//
//   2026.10 v1.3 geometry versions 4 and 6, helper points inside the geometry
//   2019.02 v1.2
//   2019.01 v1.1
//   2018.11 v1.0
//   2016.10 v0.2 initial release
//
//   A GR map's and a .pob's geometry records are the same plus a second header and collision lists
//   (MAP(gr).bt, POB(gr).bt).
//------------------------------------------------

typedef enum <ubyte> {
  no = 0,
  yes = 1
} BOOL; // bool data type

typedef struct {
  UINT Length;
  char Text[Length]; // up to the first NUL; bytes after it are stale buffer contents
} CSTRING;

// In a .qob every SectionSize counts the bytes after the name, to the record's end.
typedef struct {
  UINT SectionSize;
  UINT ID;
  struct {
    CSTRING Name <name="Version">;
    UINT Value;
  } VERSION;
  CSTRING Name <name="Name">;
} SECTION_HEADER <name="Header">;

typedef struct {
  FLOAT x;
  FLOAT y;
} POINT2;

typedef struct {
  UINT16 x;
  UINT16 y;
  UINT16 z;
} VECTOR_SHORT;

typedef struct {
  FLOAT x;
  FLOAT y;
  FLOAT z;
} VECTOR3;

typedef struct {
  FLOAT x;
  FLOAT y;
  FLOAT z;
  FLOAT d;
} PLANE;

local uint GeometryVersion; // the current geometry's header version
local ubyte GroupDetailFlag; // the current face group's DetailTexture byte

//--------------------
// File header
// --------------------

CSTRING Name <name="BeginModel">;

//--------------------
// MATERIALLIST
// --------------------

typedef struct {
  FLOAT Red;
  FLOAT Green;
  FLOAT Blue;
  FLOAT Alpha;
} COLOR; // 0-1

typedef struct {
  SECTION_HEADER Header; // id 2, version 2
  struct {
    FLOAT Opacity;
    UINT Unknown; // 3
    COLOR Ambient;
    COLOR Diffuse; // the colour of untextured faces
    COLOR Specular;
    FLOAT SpecularLevel;
    BOOL twoSide;
  } PARAMETERS;
} MATERIAL <name=MaterialName>;

typedef struct {
  SECTION_HEADER Header; // id 38, version 2 or 1
  if (Header.VERSION.Value > 1)
      BOOL Unknown; // 0; absent in version 1
  CSTRING Name <name="Texture .rsb file name">;
  struct {
    UINT TransparencyType;  // 3 or 2
    UINT IsTiled; // 0 or 3 (1 - u-tile, 2 - v-tile, 3 - both)
    FLOAT SelfIllumination; // 0
  } PARAMETERS;
} TEXTURE <name=TextureName>;

string MaterialName(MATERIAL &material) {
  return "Name: " + material.Header.Name.Text;
}

string TextureName(TEXTURE &texture) {
  return "FileName: " + texture.Header.Name.Text;
}

struct {
  SECTION_HEADER Header; // id 8, version 3 or 2, "MaterialList"
  UINT Count <name="Number of materials">;
  typedef struct (int arraySize) {
    MATERIAL array[arraySize] <optimize=false>;
  } MATERIALS;
  MATERIALS Materials(Count) <name="Materials">;
  UINT TextureCount <name="Number of textures">;
  if (TextureCount > 0)
  {
    typedef struct (int arraySize) {
      TEXTURE array[arraySize] <optimize=false>;
    } TEXTURES;
    TEXTURES TextureArray(TextureCount) <name="Textures">;
  };
} MATERIAL_LIST <name="Material List">;

//--------------------
// GEOMETRYLIST
// --------------------

// A helper point (RightHandPoint, LeftHandPoint, MuzzleFlashPoint, BrassEjectionPoint, BackBlastPoint,
// effect anchors): v' = v * (X; Y; Z) + Position, the matrix stored as row vectors.
typedef struct {
  CSTRING Name;
  struct {
    VECTOR3 X;
    VECTOR3 Y;
    VECTOR3 Z;
    VECTOR3 Position;
  } TRANSFORMATION_MATRIX;
} POINT <name=pointName>;

string pointName(POINT &point)
{
  return "Name: " + point.Name.Text;
}

// A face group: faces of one (material, texture) pair, with their own vertex params.
typedef struct {
  GroupDetailFlag = 0;
  struct {
    if (GeometryVersion > 6)
    {
      BYTE Unknown; // 1
      BYTE DetailedDarkmap;
      BYTE DetailTexture;
      GroupDetailFlag = DetailTexture;
    }
    else if (GeometryVersion > 4)
    {
      BYTE Unknown[6]; // versions 5 and 6: 01 00 00 00 00 00
    };
    // version 4: no flag bytes

    UINT MaterialIndex;
    UINT TextureCount; // texture layers: 0 or 1 in .qob
    if (TextureCount > 0)
      UINT TextureIndex;
    if (TextureCount > 0 && (GroupDetailFlag > 0 || TextureCount > 1))
      UINT DetailTextureIndex;
    if (GeometryVersion > 4)
    {
      // 0xFFFFFFFF: unset
      struct {
        UINT Unknown;
        UINT DarkMap; // a texture index
        UINT SpecularMap;
        UINT BumpMap;
        UINT ReflectionMap;
        UINT MapCount;
      } MAPPING;
    }
    else
      UINT Map; // version 4: one index, 0xFFFFFFFF
  } TEXTURE_PARAMETERS;

  struct {
    UINT Count <name="Number of faces">;
    typedef struct (int arraySize) {
      PLANE array[arraySize];
    } PLANES;
    PLANES Planes(Count) <name="Face planes">;
    typedef struct (int arraySize) {
      VECTOR_SHORT array[arraySize];
    } FACE_INDEXES;
    FACE_INDEXES FaceIndexes(Count) <name="Vertex indexes">; // into the geometry's vertexes
    typedef struct (int arraySize) {
      VECTOR_SHORT array[arraySize];
    } PARAM_INDEXES;
    PARAM_INDEXES ParamIndexes(Count) <name="Param indexes">; // into this group's params

    UINT ParamCount;
    UINT UVSetCount; // with a detail texture the sets are (texture, detail); dark-mapped: (darkmap, texture)
    typedef struct (int arraySize) {
      VECTOR3 array[arraySize];
    } NORMALS;
    NORMALS Normals(ParamCount) <name="Normals">;
    typedef struct (int arraySize) {
      POINT2 array[arraySize];
    } UVs;
    UVs TextureCoordinates(ParamCount*UVSetCount) <name="Texture coordinates">; // set after set
    typedef struct (int arraySize) {
      COLOR array[arraySize] <optimize=false>;
    } PARAM_COLOR;
    PARAM_COLOR Colors(ParamCount) <name="Param colors">; // RGBA 0-1
  } FACE_PARAMETERS;
} MESH <name="Face group">;

struct {
  SECTION_HEADER Header; // id 7, version 1 "GeometryList"
  UINT Count <name="Number of objects">; // 1
  typedef struct {
    // id 3; version 8, 7, 6 or 4.
    // Size: from after this header to the end of the helper points.
    SECTION_HEADER Header;
    GeometryVersion = Header.VERSION.Value;
    if (GeometryVersion > 6)
    {
      BOOL DarkMapped <name="DarkMapped">;
      BOOL CastShadows <name="CastShadows">;
    };
    struct {
      UINT Count <name="Number of vertexes">;
      typedef struct (int arraySize) {
        VECTOR3 array[arraySize];
      } VERTEXES;
      VERTEXES Vertexes(Count) <name="Vertexes">;
    } VERTEXES_SECTION <name="Vertex section">;

    UINT Count <name="Number of face groups">;
    typedef struct (int arraySize) {
      MESH array[arraySize] <optimize=false>;
    } MESHES;
    MESHES Meshes(Count) <name="Face groups">;

    if (GeometryVersion > 4)
    {
      // Helper points; none in version 4.
      struct {
        UINT PointCount;
        if (PointCount > 0)
        {
          typedef struct (int arraySize) {
            POINT array[arraySize] <optimize=false>;
          } POINTS <optimize=false>;
          POINTS Points(PointCount) <optimize=false, name="Points">;
        };
      } POINT_LIST <name="Point List">;
    };
  } OBJECT;
  typedef struct (int arraySize) {
    OBJECT array[arraySize] <optimize=false>;
  } OBJECTS;
  OBJECTS Objects(Count) <name="Objects">;
} GEOMETRY_LIST  <name="Geometry List">;

CSTRING Name <name="EndModel">;
