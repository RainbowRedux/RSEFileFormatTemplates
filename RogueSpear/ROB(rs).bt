//------------------------------------------------
//--- 010 Editor v7.0 Binary Template
//
//      File: ROB.bt
//   Authors: Alexander Evdokimov
//   Version: 1.1
//   Purpose: Rainbow Six Rogue Spear ROB file (dynamic models: a .qob plus collision lists)
// File Mask: *.rob
//
//   History:
//   2026.10 v1.1 collision lists, face planes, texture address mode, geometry flags; which fields the
//         game skips
//   2019 v1.0
//   2017 v0.5 initial release
//------------------------------------------------

string readCString()
{
  local uint Length;
  local string Name;
  Length = ReadInt(FTell());
  FSkip(4);
  Name = ReadString(FTell());
  FSkip(-4);
  return Name;
};

typedef struct {
  FLOAT Red;
  FLOAT Green;
  FLOAT Blue;
  FLOAT Alpha;
} COLOR4F; // 0-1

typedef enum <ubyte> {
  no = 0,
  yes = 1
} BOOL; // bool data type

typedef struct {
  UINT Length; // counts the NUL
  char Text[Length];
} CSTRING;

// Rogue Spear: SectionSize counts the bytes after the name, to the record's end
// (R6's .sob: after the size field).
typedef struct {
  UINT SectionSize;
  UINT ID;
  CSTRING Name <name="Version">;
  if (Name.Text == "Version") {
    UINT Value;
    CSTRING Name <name="Name">;
  };
} SECTION_HEADER <name="Header">;

// Direct3D's D3DTADDRESS_* values. The game ignores the stored mode: textures wrap.
typedef enum <uint> {
  WRAP = 1,
  CLAMP = 3
} TEXTURE_ADDRESS_MODE;

// Geometry flags (GF_*), the same bits as a .sob/.map mesh's flags
BitfieldRightToLeft();
typedef struct {
  DWORD Climbable      : 1; // 0x1  ladders, nets
  DWORD NoCollide2D    : 1; // 0x2  no floor triangles, no 2-D collision
  DWORD Invisible      : 1; // 0x4  not drawn, not hit by line tests
  DWORD Unknown8       : 1; // 0x8  not hit by line tests (aiming, camera, blasts); with 0x4 on RS maps' boundary boxes
  DWORD FloorPolygon   : 1; // 0x10 floor surface
  DWORD NoCollide3D    : 1; // 0x20
  DWORD ForceFloor     : 1; // 0x40 a floor even when steep (ramps, stairs)
  DWORD NotShownInPlan : 1; // 0x80
  DWORD Unused         : 24;
} GEOMETRY_FLAGS;

typedef struct {
  UINT16 a;
  UINT16 b;
  UINT16 c;
} VECTOR_SHORT;

typedef struct {
  FLOAT x;
  FLOAT y;
  FLOAT z;
} VECTOR3F;

typedef struct {
  FLOAT x;
  FLOAT y;
  FLOAT z;
  FLOAT d; // d = -n.v0
} PLANE;

typedef struct {
  FLOAT u;
  FLOAT v;
} POINT2;

// BeginModel token

CSTRING BeginModel <name="BeginModel token">;

//--------------------
// MaterialList
// --------------------

typedef struct {
  SECTION_HEADER Header; // id 2, version 1
  CSTRING Name <name="Texture filename">; // "NULL": untextured
  struct {
    FLOAT Opacity;  // skipped by the game: the alpha is the colours' own A
    FLOAT Emissive; // textured materials only: the texture's self-illumination
    TEXTURE_ADDRESS_MODE AddressMode; // skipped by the game: textures wrap
    COLOR4F Ambient;  // skipped by the game (white)
    COLOR4F Diffuse;
    COLOR4F Specular;
    FLOAT SpecularLevel; // kept as a whole number
    BOOL twoSided;  // skipped by the game
  } MATERIAL_PROPERTIES;
} MATERIAL <name=MaterialName>;

string MaterialName(MATERIAL &material) {
  return "Name: " + material.Header.Name.Text;
}

struct {
  SECTION_HEADER Header; // id 8 "MaterialList"
  UINT Count <name="Number of materials">;
  typedef struct (int arraySize) {
    MATERIAL array[arraySize] <optimize=false>;
  } MATERIALS;
  MATERIALS Materials(Count) <name="Materials">;
} MATERIAL_LIST <name="Material list">;

//--------------------
// GeometryList
// --------------------

// Drawn faces of one material, with their own vertex params (normal, uv, colour).
typedef struct {
  struct {
    UINT Index <name="Index of the material">; // 0xFFFFFFFF: none

    UINT Count <name="Number of faces">;
    typedef struct (int arraySize) {
      PLANE array[arraySize];
    } PLANES;
    PLANES Planes(Count) <name="Face planes">; // normal along the winding

    typedef struct (int arraySize) {
      VECTOR_SHORT array[arraySize];
    } FACE_INDEXES;
    FACE_INDEXES FaceIndexes(Count) <name="Vertex indexes">; // into the object's vertexes

    typedef struct (int arraySize) {
      VECTOR_SHORT array[arraySize];
    } PARAM_INDEXES;
    PARAM_INDEXES ParamIndexes(Count) <name="Param indexes">; // into this group's params

    UINT ParamCount;
    typedef struct (int arraySize) {
      VECTOR3F array[arraySize];
    } NORMALS;
    NORMALS Normals(ParamCount) <name="Normals">;
    typedef struct (int arraySize) {
      POINT2 array[arraySize];
    } UVs;
    UVs TextureCoordinates(ParamCount) <name="Texture coordinates">;
    typedef struct (int arraySize) {
      COLOR4F array[arraySize] <optimize=false,name="RGBA Color">;
    } VERTEX_COLOR4F;
    VERTEX_COLOR4F Colors(ParamCount) <name="Param colors">;
  } GEOMETRY_DATA <name="Geometry data section">;
} MESH <name="Face group">;

// 16 bytes. Group -1: V index the collision vertexes, K the collision planes (faces no drawn group has:
// invisible walls, boundary boxes). Else V are the drawn vertexes of that group's face K, whose plane it
// takes. Each drawn face has exactly one, with the same corners.
typedef struct {
  UINT16 V[3];
  UINT16 K;         // plane index (group -1) or face index in the group
  UINT16 MeshIndex; // the collision mesh listing this face; the game takes the face's flags through it
  UINT16 Zero;      // 0; skipped by the game
  INT Group;        // -1: own lists (the game keeps the low 16 bits)
} COLLISION_FACE;

typedef struct {
  CSTRING Name; // "NONE", ...
  GEOMETRY_FLAGS Flags;
  UINT Count;
  UINT16 Faces[Count] <name="Collision face indexes">;
} COLLISION_MESH <name=CollisionMeshName>;

string CollisionMeshName(COLLISION_MESH &m) {
  return m.Name.Text;
}

struct {
  SECTION_HEADER Header; // id 7 "GeometryList"
  UINT Count <name="Number of the objects">;
  typedef struct {
    SECTION_HEADER Header <name="Object header">;     // id 35, version 2; size to the end of the collision lists
    SECTION_HEADER Header <name="Drawn part header">; // id 3, version 2, same name; size to the end of the face groups

    UINT VertexCount <name="Number of vertexes">;

    typedef struct (int arraySize) {
      VECTOR3F array[arraySize];
    } VERTEXES;
    VERTEXES Vertexes(VertexCount) <name="Vertexes">;

    UINT MeshCount <name="Number of face groups">;

    typedef struct (int arraySize) {
      MESH array[arraySize] <optimize=false>;
    } MESHES;
    MESHES Meshes(MeshCount) <name="Face groups">;

   // Collision lists
   struct {
     UINT VertexCount <name="Number of collision vertexes">;
     VECTOR3F Vertexes[VertexCount] <name="Collision vertexes">;
     UINT PlaneCount <name="Number of collision planes">;
     PLANE Planes[PlaneCount] <name="Collision planes">;

     UINT FaceCount <name="Number of collision faces">;
     COLLISION_FACE Faces[FaceCount] <name="Collision faces">;

     UINT MeshCount <name="Number of collision meshes">;
     typedef struct (int arraySize) {
       COLLISION_MESH array[arraySize] <optimize=false>;
     } COLLISION_MESHES;
     COLLISION_MESHES Meshes(MeshCount) <name="Collision meshes">;
   } COLLISION <name="Collision">;
 } OBJECT;
 typedef struct (int arraySize) {
   OBJECT array[arraySize] <optimize=false>;
 } OBJECTS;
 OBJECTS Objects(Count) <name="Objects">;
} ROBGEOMETRYLIST  <name="GeometryList">;

CSTRING EndModel <name="EndModel token">;
