//------------------------------------------------
//--- 010 Editor v8.0.1 Binary Template
//
//      File: SKL(rs).bt
//   Authors:
//   Version: 0.2
//   Purpose: Rainbow Six Rogue Spear SKL file (character skeleton)
//  Category:
// File Mask: *.skl
//  ID Bytes: 00 00 C0 3F
//   History:
//   2026.10 v0.2 version, sibling/child flags, bone index, per-bone bounds
//------------------------------------------------
//
// The R6 layout byte for byte after a leading f32 version. A bone count, then the tree serialised
// post-order: each node is
//   [UBYTE HasSibling, next-sibling subtree] [UBYTE HasChild, first-child subtree] BONE
// so the root (Hips) is the last record. A node's children are its first child and that child's sibling
// chain. 18 bones.

typedef struct {
  struct {
    FLOAT x;
    FLOAT y;
    FLOAT z;
  } XAXIS;
  struct {
    FLOAT x;
    FLOAT y;
    FLOAT z;
  } YAXIS;
  struct {
    FLOAT x;
    FLOAT y;
    FLOAT z;
  } ZAXIS;
  struct {
    FLOAT Y; // order as in SKL(r6).bt; all three always 0
    FLOAT X;
    FLOAT Z;
  } POSITION;
} TRANSFORMATION_MATRIX; // always identity, zero position

struct {
  FLOAT Version; // 1.5
  UINT BoneCount;
} FILE_HEADER;

typedef struct {
  // relative to the parent; the bind pose is translation-only
  struct {
    FLOAT X;
    FLOAT Y;
    FLOAT Z;
  } POSITION_REL;
  // always identity (0, 0, 0, 1)
  struct {
    FLOAT X;
    FLOAT Y;
    FLOAT Z;
    FLOAT W;
  } ROTATION_REL;
  //
  TRANSFORMATION_MATRIX Matrix;
  // absolute: the sum of POSITION_REL down the tree
  struct {
    FLOAT X;
    FLOAT Y;
    FLOAT Z;
  } POSITION_ABS;
  // always identity (0, 0, 0, 1)
  struct {
    FLOAT X;
    FLOAT Y;
    FLOAT Z;
    FLOAT W;
  } ROTATION_ABS;
  // meaning unknown; always 0, 0, 0, 1
  FLOAT X;
  FLOAT Y;
  FLOAT Z;
  FLOAT W;
  //
  UINT Length;
  CHAR Name[Length]; // NUL included
  UINT BoneIndex; // numbers the .DAM quaternions and the CRP parts' bones

  BYTE HasBounds; // always 1
  if (HasBounds == 1)
  {
    // Per-bone bounds in bone space; use unknown (hit or culling volumes).
    struct {
      // around the bone's segments to its children (a leaf: around its part's vertices)
      FLOAT X;
      FLOAT Y;
      FLOAT Z;
      FLOAT Radius;
    } SPHERE;
    // a capsule along the bone's y axis through the box of its part's vertices, its children's offsets
    // and (RS only) the bone's origin
    struct {
      FLOAT X;
      FLOAT Y;
      FLOAT Z;
    } CAPSULE_BOTTOM; // box centre x/z, box min y
    struct {
      FLOAT X;
      FLOAT Y;
      FLOAT Z;
    } CAPSULE_TOP; // box centre x/z, box max y
    FLOAT CapsuleRadius; // 0.85 x the farthest vertex's distance from the axis
  }
} BONE <optimize=false, name=getBoneName>;


string getBoneName(BONE &Bone)
{
  return Bone.Name;
}

void ReadBone()
{
  UBYTE HasSibling;
  if (HasSibling == 1)
    ReadBone(); // the next sibling's subtree
  UBYTE HasChild;
  if (HasChild == 1)
    ReadBone(); // the first child's subtree
  BONE Bone;

};

ReadBone();
