//------------------------------------------------
//--- 010 Editor v7.0 Binary Template
//
//      File: QOB(rsp).bt
//   Authors: Alexander Evdokimov
//   Version: 0.3
//   Purpose: Rogue Spear QOB file (static models; ROB(rs).bt adds collision lists)
// File Mask: *.qob
//
//   History:
//   2026.10 v0.3 face planes, param indexes, texture address mode; which fields the game skips
//   2016.10 v0.2 initial release
//------------------------------------------------

typedef enum <ubyte> {
    no,
    yes
} BOOL; // bool data type

typedef struct {
  UINT Length; // counts the NUL
  char Text[Length];
} CSTRING;

// SectionSize counts the bytes after the name, to the record's end (R6's .sob: after the size field).
typedef struct {
  UINT SectionSize;
  UINT ID;

  CSTRING Name;
  if (Name.Text == "Version") {
      UINT Value;
      CSTRING Name <name="Name">;
  };
} HEADER <name="Header">;

typedef struct {
  FLOAT Red;
  FLOAT Green;
  FLOAT Blue;
  FLOAT Alpha;
} COLOR4F; // 0-1

typedef struct {
  FLOAT x;
  FLOAT y;
  FLOAT z;
} VECTOR3F;

typedef struct {
  FLOAT x;
  FLOAT y;
} VECTOR2F;

typedef struct {
  UINT16 x;
  UINT16 y;
  UINT16 z;
} VECTOR3U16;

// Direct3D's D3DTADDRESS_* values. The game ignores the stored mode: textures wrap.
typedef enum <uint> {
  WRAP = 1,
  CLAMP = 3
} TEXTURE_ADDRESS_MODE;

//--------------------
// File header
// --------------------

struct {
  CSTRING Name; // "BeginModel"
} QOB_FILE_HEADER <name="QOB Header", fgcolor=cBlack, bgcolor=0xccff66>;

//--------------------
// MATERIALLIST
// --------------------

typedef struct {
  HEADER header; // id 2, version 1

  CSTRING Name <name="Texture filename">; // "NULL": untextured

  struct {
    FLOAT Opacity;  // skipped by the game: the alpha is the colours' own A
    FLOAT Emissive; // textured materials only: the texture's self-illumination
    TEXTURE_ADDRESS_MODE AddressMode; // skipped by the game: textures wrap
    COLOR4F Ambient;  // skipped by the game (white)
    COLOR4F Diffuse;
    COLOR4F Specular;
    FLOAT SpecularLevel; // kept as a whole number
    BOOL twoSided;  // skipped by the game
  } MATERIAL_PROPERTIES;
} MATERIAL <name=MaterialName>;

string MaterialName(MATERIAL &material) {
  return "Name: " + material.header.Name.Text + " ";
}

struct {

  HEADER Header <name="Section header">; // id 8 "MaterialList"

  struct {
    UINT Count <name="Number of materials">;

    typedef struct (int arraySize) {
      MATERIAL array[arraySize] <optimize=false>;
    } MATERIAL_ARRAY;

    MATERIAL_ARRAY MaterialArray(Count) <name="Materials">;
  } Materials <name="1.1 Materials section">;

} MATERIALLIST <name="MaterialList section">;

//--------------------
// QOBGEOMETRYLIST
// --------------------

// Drawn faces of one material, with their own vertex params (normal, uv, colour).
typedef struct {
   UINT MaterialIndex; // 0xFFFFFFFF: none

   struct {
      UINT FaceCount;

      typedef struct {
        FLOAT X;
        FLOAT Y;
        FLOAT Z;
        FLOAT Distance; // d = -n.v0
       } FACE_PLANE;

      typedef struct (int arraySize) {
        FACE_PLANE array[arraySize];
      } FACE_PLANE_ARRAY;

      FACE_PLANE_ARRAY FacePlanes(FaceCount) <name="Face planes">; // normal along the winding

      typedef struct (int arraySize) {
        VECTOR3U16 array[arraySize] <name="Vertex indexes">;
      } FACE_INDEXES;

      FACE_INDEXES FaceIndexes(FaceCount) <name="Face Indexes">; // into the object's vertexes

      typedef struct (int arraySize) {
        VECTOR3U16 array[arraySize];
      } PARAM_INDEXES;

      PARAM_INDEXES ParamIndexes(FaceCount) <name="Param indexes">; // into this group's params

  } Faces <name="Faces">;

  struct {
    UINT ParamCount;

    typedef struct (int arraySize) {
      VECTOR3F array[arraySize] <name="Normal">;
    } NORMALS;

    NORMALS Normals(ParamCount) <name="Vertex Normals">;

    typedef struct (int arraySize) {
       VECTOR2F array[arraySize] <name="UV">;
    } UV_COORDINATES;

    UV_COORDINATES TextureCoordinates(ParamCount) <name="Texture coordinates">;

    typedef struct (int arraySize) {
       COLOR4F array[arraySize] <optimize=false, name="RGBA color">;
    } PARAM_COLOR;
    PARAM_COLOR Colors(ParamCount) <name="Param colors">;

  } PARAMS <name="Vertex params">;
} MESH <name="Face group">;


struct {
  HEADER Header <name="GeometryList Header">; // id 7 "GeometryList"

  UINT Count <name="Object Count">;

  typedef struct {
    //  section header
    HEADER Header <name="Section header">; // id 3, version 2

    UINT VertexCount;

    typedef struct (int arraySize) {
      VECTOR3F array[arraySize] <name="Vertex">;
    } VERTEXES;
    VERTEXES VertexArray(VertexCount) <name="Vertexes">;

    UINT MeshCount; // face groups

    typedef struct (int arraySize) {
      MESH array[arraySize] <optimize=false>;
    } MESHES;

    MESHES Meshes(MeshCount) <name="Face groups">;

 } OBJECT <name="Object">;

  typedef struct (int arraySize) {
    OBJECT array[arraySize] <optimize=false>;
  } OBJECTS;

  OBJECTS GeometryDataArray(Count) <name="Objects">;


} QOBGEOMETRYLIST  <name="GeometryList Section">;

struct {
  UINT Length;
  char String[Length]; // "EndModel"
} ENDMODEL_STRING <name="QOB File End">;
